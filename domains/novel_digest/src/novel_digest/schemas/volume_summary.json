{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "novel_volume_summary",
  "type": "object",
  "required": ["volume", "summary", "chapter_range", "volume_ok"],
  "properties": {
    "volume": {"type": "integer"},
    "summary": {"type": "string"},
    "chapter_range": {
      "type": "object",
      "required": ["first", "last"],
      "properties": {
        "first": {"type": "string"},
        "last": {"type": "string"}
      }
    },
    "key_events": {"type": "array", "items": {"type": "string"}},
    "volume_ok": {"type": "boolean"}
  }
}
