{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "novel_consistency_report",
  "type": "object",
  "required": ["contradictions", "checked_entities", "checked_events", "consistency_ok"],
  "properties": {
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "description", "locations"],
        "properties": {
          "kind": {"type": "string"},
          "description": {"type": "string"},
          "locations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "checked_entities": {"type": "integer", "minimum": 0},
    "checked_events": {"type": "integer", "minimum": 0},
    "consistency_ok": {"type": "boolean"}
  }
}
